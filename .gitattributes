# Normalize line endings: LF in the repo, native handling per platform.
* text=auto

# Source and config: always LF, everywhere.
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch.
*.pt binary
*.pth binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary
